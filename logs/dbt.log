[0m00:02:27.274158 [debug] [Thread-1 (]: On model.snowflake_project.total_sales_vw: /* {"app": "dbt", "dbt_version": "1.8.5", "profile_name": "snowflake_project", "target_name": "dev", "node_id": "model.snowflake_project.total_sales_vw"} */
create or replace   view DQLABS_QA.DBT_CORE.total_sales_vw
  
   as (
    

WITH total_sales_vw as (
SELECT 
    es.COMPANY_INFO,
    es.PRODUCTID,
    SUM(ps.TOTAL_AMOUNT_SALES) AS TOTAL_SALES_AMOUNT
FROM 
    DQLABS_QA.DBT_CORE.employee_sales_vw es
JOIN 
    DQLABS_QA.DBT_CORE.product_sales_vw ps
    ON es.PRODUCTID = ps.PRODUCTID
GROUP BY 
    es.COMPANY_INFO,
    es.PRODUCTID
)
SELECT * FROM total_sales_vw
  );
