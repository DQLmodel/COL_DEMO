[0m04:45:54.343729 [debug] [Thread-1 (]: On model.snowflake_project.customers: /* {"app": "dbt", "dbt_version": "1.8.5", "profile_name": "snowflake_project", "target_name": "dev", "node_id": "model.snowflake_project.customers"} */
create or replace transient table DQLABS_QA.DBT_CORE.customers
         as
        (with customers as (

    select * from DQLABS_QA.DBT_CORE.stg_customers

),

orders as (

    select * from DQLABS_QA.DBT_CORE.stg_orders

),

customer_orders as (

    select
        customer_id,

        min(order_date) as first_order_date,
        max(order_date) as most_recent_order_date,
        count(order_id) as number_of_orders

    from orders

    group by 1

),

final as (

    select
        customers.customer_id,
        customers.first_name,
        customers.last_name,
        customer_orders.first_order_date,
        customer_orders.most_recent_order_date,
        coalesce(customer_orders.number_of_orders, 0) as number_of_orders

    from customers

    left join customer_orders using (customer_id)

)

select * from final
        );
